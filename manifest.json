{
  "manifest_version": 3,
  "name": "YouTube Article Mode",
  "version": "0.3",
  "description": "Turns YouTube videos into readable AI-generated articles.",
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
